{
  "mcpServers": {
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_TOKEN",
        "-e",
        "TFE_ADDRESS=https://app.terraform.io",
        "hashicorp/terraform-mcp-server:1.3.0",
        "--toolsets=registry-private,terraform"
      ]
    }
  }
}
